{
  "name": "draw-the-play-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --import tsx --test src/*.test.js",
    "data:refresh": "python3 scripts/build_catalog.py --refresh",
    "sim:audit": "node --import tsx scripts/simulation-audit.mjs",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "test:multiplayer": "node scripts/test-multiplayer.mjs",
    "dev:api": "wrangler dev --port 8787"
  },
  "dependencies": {
    "firebase": "12.11.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vite": "^6.2.0",
    "wrangler": "4.142.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
